{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vaak-backend",
  "main": "src/main.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "python_workers"
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
  // Hyperdrive binding will be added here:
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<HYPERDRIVE_CONFIG_ID>"
  //   }
  // ]
}
