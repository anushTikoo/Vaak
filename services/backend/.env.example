# ==========================================
# Vaak (वाक्) Backend Environment Configuration
# ==========================================

# Server Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS (Comma-separated list of origins)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Sarvam AI Credentials (Keep confidential)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_ENDPOINT=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_TTS_ENDPOINT=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_LLM_MODEL=sarvam-105b-conversations

# Zepto MCP Configuration (Public PKCE client, no secret needed)
ZEPTO_MCP_ENDPOINT=https://mcp.zepto.co.in/mcp
ZEPTO_CLIENT_ID=576d1696ca6ecbf3f9eb0db780546d50

# Database (Neon PostgreSQL via Cloudflare Hyperdrive or direct connection)
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/vaak_db?sslmode=require
